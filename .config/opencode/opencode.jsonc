{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gitlab": {
      "type": "remote",
      "url": "http://gitlab-mcp:3002/mcp",
      "headers": {
        "Authorization": "Bearer {env:STREAMABLE_HTTP_AUTH_TOKEN}"
      },
      "oauth": false
    },
    "github": {
      "type": "remote",
      "url": "http://github-mcp:3003/mcp",
      "oauth": false
    }
  },
  "permission": {
    "*": "allow"
  },
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "opencode-go/glm-5.2",
      "description": "Plans work and delegates all execution to the worker subagent. Cannot read code, run commands, or call MCP tools directly.",
      "prompt": "You are an orchestrator. You cannot read files, run commands, or call any MCP tool yourself - every one of those is denied. Break the task down and delegate all actual work (reading code, running commands, calling GitLab/GitHub tools) to the worker subagent via the task tool, then synthesize its results.",
      "permission": {
        "read": "deny",
        "edit": "deny",
        "bash": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "skill": "deny",
        "external_directory": "deny",
        "todowrite": "deny",
        "gitlab_*": "deny",
        "github_*": "deny",
        "task": {
          "*": "allow"
        }
      }
    },
    "worker": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Does the actual work: reads code, runs commands, and calls GitLab/GitHub MCP tools on behalf of the orchestrator."
    }
  }
}
