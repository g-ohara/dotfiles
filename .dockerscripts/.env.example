# Copy to .env and fill in real values.
# This file is tracked; .env is git-ignored.

# GitLab API endpoint (include /api/v4).
GITLAB_API_URL=https://gitlab.com/api/v4

# GitLab Personal Access Token used by the MCP server to call the GitLab API.
GITLAB_PERSONAL_ACCESS_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Shared secret that OpenCode / Hermes send as
# "Authorization: Bearer <value>" to reach the MCP /mcp endpoint.
# Any random string works (e.g. `openssl rand -hex 32`).
STREAMABLE_HTTP_AUTH_TOKEN=replace-with-random-secret

# GitHub Personal Access Token for the hosted GitHub MCP server
# (https://api.githubcopilot.com/mcp/). Sent directly by OpenCode/Hermes
# as "Authorization: Bearer <value>". Recommended scopes: repo, read:org.
GITHUB_PERSONAL_ACCESS_TOKEN=ghp-xxxxxxxxxxxxxxxxxxxx